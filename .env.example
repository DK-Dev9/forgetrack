# ForgeTrack Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=forge-track-insecure-dev-key-change-in-production-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=forgetrack
DB_USER=forgetrack_user
DB_PASSWORD=forgetrack_secret_password
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
